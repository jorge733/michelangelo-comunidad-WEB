rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Un editor de Studio es una cuenta con correo y contraseña cuyo UID existe
    // en /editores. Las sesiones anónimas del formulario público nunca cuentan.
    function isEditor() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/editores/$(request.auth.uid));
    }

    // Rol de la cuenta en Studio. Las cuentas registradas antes de que
    // existieran los roles no tienen el campo y conservan acceso completo.
    function editorRole() {
      return get(/databases/$(database)/documents/editores/$(request.auth.uid)).data.get('rol', 'admin');
    }

    // Administración siempre tiene acceso, además de los roles indicados.
    function hasRole(roles) {
      return isEditor() && editorRole() in roles.concat(['admin']);
    }

    // Qué rol puede publicar o modificar cada sección pública.
    function canPublishIn(seccion) {
      return (seccion == 'vida' && hasRole(['audiovisual']))
        || (seccion in ['centro', 'calendario'] && hasRole(['centro']));
    }

    // Qué rol revisa cada tipo de aporte de Participa. Studio consulta
    // filtrando por «tipo», así que las listas deben coincidir con studio.js.
    function canReviewAporte(tipo) {
      return (tipo in ['periodico', 'creacion', 'podcast', 'idea'] && hasRole(['editorial']))
        || (tipo == 'centro' && hasRole(['centro']));
    }

    function validMember(data) {
      return data.keys().hasOnly(['rol', 'correo', 'actualizadoEn', 'actualizadoPor'])
        && data.rol in ['admin', 'editorial', 'centro', 'audiovisual']
        && data.get('correo', '') is string
        && data.get('correo', '').size() <= 200
        && data.get('actualizadoPor', '') is string
        && data.get('actualizadoEn', request.time) == request.time;
    }

    // Equipo de Studio. Las cuentas se crean en Firebase Authentication y
    // Administración decide aquí quién entra y con qué rol. Nadie puede
    // cambiar su propio rol ni quitarse el acceso, así siempre queda al
    // menos una cuenta de Administración.
    match /editores/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || hasRole([]);
      allow create: if hasRole([]) && validMember(request.resource.data);
      allow update: if (hasRole([]) && request.auth.uid != uid && validMember(request.resource.data))
        // Cada cuenta mantiene su correo al día para que el equipo la reconozca.
        || (isEditor() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['correo'])
          && request.resource.data.correo == request.auth.token.email);
      allow delete: if hasRole([]) && request.auth.uid != uid;
    }

    // Bandeja privada: el público solo puede crear aportes; Studio autenticado
    // puede revisarlos y cambiar su estado, sin borrarlos desde el cliente.
    match /aportes/{aporteId} {
      allow create: if request.resource.data.keys().hasOnly([
          'tipo', 'nombre', 'curso', 'contacto', 'anonimoPublicamente', 'titulo',
          'descripcion', 'detalles', 'quiereParticipar', 'estado', 'creadoEn'
        ])
        && request.resource.data.get('contacto', '') is string
        && request.resource.data.get('contacto', '').size() <= 200
        && request.resource.data.tipo in ['periodico', 'creacion', 'podcast', 'idea', 'centro']
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.curso is string
        && request.resource.data.curso.size() <= 60
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() <= 200
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() <= 5000
        && request.resource.data.detalles is map
        && request.resource.data.detalles.size() <= 20
        && request.resource.data.anonimoPublicamente is bool
        && request.resource.data.quiereParticipar is bool
        && request.resource.data.creadoEn == request.time;

      allow read: if hasRole([]) || canReviewAporte(resource.data.tipo);
      // Studio solo puede cambiar el estado editorial y su nota interna; el
      // aporte conserva siempre su información original y su preferencia de
      // anonimato.
      allow update: if canReviewAporte(resource.data.tipo)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'notaEditorial', 'actualizadoEn', 'actualizadoPor'])
        && request.resource.data.estado in ['pendiente', 'revision', 'aprobado', 'rechazado']
        && request.resource.data.get('notaEditorial', '') is string
        && request.resource.data.get('notaEditorial', '').size() <= 4000
        && request.resource.data.get('actualizadoPor', '') is string
        && request.resource.data.get('actualizadoEn', request.time) == request.time;
      allow delete: if false;
    }

    // Solo Studio crea contenido en esta colección. Al contener únicamente
    // publicaciones ya aprobadas, puede leerse desde las páginas públicas.
    match /publicaciones/{publicacionId} {
      allow read: if true;
      allow create: if canPublishIn(request.resource.data.seccion)
        && request.resource.data.keys().hasOnly([
          'seccion', 'aporteId', 'titulo', 'descripcion', 'autor', 'archivo',
          'imagenUrl', 'videoUrl', 'publicadoEn', 'fecha', 'hora', 'lugar'
        ])
        && request.resource.data.seccion in ['vida', 'centro', 'calendario']
        // Las actividades del calendario guardan su día como AAAA-MM-DD.
        && (request.resource.data.seccion != 'calendario'
          || (request.resource.data.get('fecha', '') is string
            && request.resource.data.get('fecha', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.titulo is string
        && request.resource.data.descripcion is string
        && request.resource.data.autor is string
        && request.resource.data.publicadoEn is timestamp;
      allow update: if canPublishIn(resource.data.seccion)
        && request.resource.data.seccion == resource.data.seccion;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
