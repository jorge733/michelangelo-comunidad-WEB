rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Mismo criterio que firestore.rules: cuenta con correo y contraseña
    // registrada en /editores. Las sesiones anónimas nunca son editores.
    function isEditor() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && firestore.exists(/databases/(default)/documents/editores/$(request.auth.uid));
    }

    // Igual que en firestore.rules: sin campo «rol» la cuenta es Administración,
    // y Administración tiene acceso a todo.
    function hasRole(role) {
      return isEditor()
        && firestore.get(/databases/(default)/documents/editores/$(request.auth.uid)).data.get('rol', 'admin') in [role, 'admin'];
    }

    // Las fotos de aportes públicos nunca se leen desde el sitio público.
    // El equipo editorial las revisa antes de cualquier publicación.
    match /aportes/{aporteId}/fotografias/{fileName} {
      // La página crea una sesión anónima de Firebase antes de cargar. Así
      // estudiantes no necesitan registro, pero Storage no acepta escrituras
      // completamente anónimas desde cualquier cliente externo.
      allow create: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read: if hasRole('editorial');
      allow delete: if false;
    }

    // Los videos solo los sube y revisa el equipo audiovisual desde Studio.
    match /publicaciones/{publicacionId}/videos/{fileName} {
      allow create, update: if hasRole('audiovisual')
        && request.resource.size <= 250 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm)');
      allow read: if hasRole('audiovisual');
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
